<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_az_medical_device_list" model="ir.ui.view">
        <field name="name">az.medical.device.list</field>
        <field name="model">az.medical.device</field>
        <field name="arch" type="xml">
            <list string="Medical Devices">
                <field name="name"/>
                <field name="serial_number"/>
                <field name="brand"/>
                <field name="model_number"/>
                <field name="hospital_id"/>
                <field name="status"/>
                <field name="warranty_end"/>
                <field name="maintenance_count"/>
            </list>
        </field>
    </record>

    <record id="view_az_medical_device_form" model="ir.ui.view">
        <field name="name">az.medical.device.form</field>
        <field name="model">az.medical.device</field>
        <field name="arch" type="xml">
            <form string="Medical Device">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_maintenance_history" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="maintenance_count" widget="statinfo" string="Maintenance"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="serial_number"/>
                            <field name="product_id"/>
                            <field name="brand"/>
                            <field name="model_number"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="hospital_id"/>
                            <field name="purchase_date"/>
                            <field name="sale_date"/>
                            <field name="warranty_end"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                        <page string="Maintenance History">
                            <field name="maintenance_ticket_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="received_date"/>
                                    <field name="hospital_id"/>
                                    <field name="status"/>
                                    <field name="final_cost"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_az_medical_device" model="ir.actions.act_window">
        <field name="name">Medical Devices</field>
        <field name="res_model">az.medical.device</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
